# Optional shell environment variables. They set the defaults for the matching
# flags, so you can drop --secrets/--start/--end from every command.
#
# Nothing here is loaded automatically: the core of this tool depends on numpy
# and nothing else, and pulling in python-dotenv to read one file would be a
# poor trade. Export them yourself, or source this file:
#
#   set -a; . ./.env; set +a          # bash / zsh
#   gc .env | %{ $kv = $_ -split '=',2; [Environment]::SetEnvironmentVariable($kv[0],$kv[1]) }   # PowerShell

# Path to the OAuth client downloaded from Google Cloud (Desktop app type).
# Sets the default for --secrets on `autopsy auth` and `autopsy scan`.
AUTOPSY_CLIENT_SECRETS=./client_secrets.json

# Optional: restrict the retention window. Defaults to the last 365 days.
# Sets the defaults for --start and --end on `autopsy scan`.
AUTOPSY_START_DATE=2025-01-01
AUTOPSY_END_DATE=2026-08-13
